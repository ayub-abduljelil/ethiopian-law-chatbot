# ── Google Gemini (LLM) ───────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── PostgreSQL (Knowledge Base) ───────────────────────────────────────────
# The hosted database already contains the full embedded legal corpus.
# Contact the project maintainer for credentials.
PGHOST=your_pg_host
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=your_pg_user
PGPASSWORD=your_pg_password
